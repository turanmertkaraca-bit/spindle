# gradle
.gradle/
build/
*/build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# kotlin
.kotlin/

# ide
.idea/
*.iml
.vscode/

# os
.DS_Store

# local only (proxy/truststore is machine-specific)
gradle.local.properties
local.properties

# secrets
*.keystore
*.jks
.env
secrets.properties

# The DEBUG signing key is intentionally committed: it is not a secret (default
# store/key password "android") and a stable signature lets a new debug APK
# install cleanly over the previous one.
!debug.keystore

# test output
**/test-results/
**/reports/
fixtures/live/

# read-only parity reference clone (opencode-android)
.ref/

# Local screenshot review artifacts
.screenshots/

# Agent tool-output spill files
.spindle/

# local release artifacts (published by CI)
dist/
